import {
    Button,
    ListView,
    AboutSlint,
    LineEdit,
    Date,
} from "std-widgets.slint";
import { Modal } from "components/modal.slint";
import { DateInput } from "components/date-input.slint";
export component Main inherits Window {
    callback new-task(string, int, Date) -> bool;

    maximized: true;

    min-height: 500px;
    min-width: 500px;

    new_task_popup := Modal {
        window-width: root.width;
        window-height: root.height;

        VerticalLayout {
            padding: 10px;
            cross-axis-alignment: CrossAxisAlignment.start;

            Text {
                text: "New Task";
            }

            Text {
                text: "Task name";
            }

            name-input := LineEdit {
                width: 75%;
                placeholder-text: "Task name";
            }

            Text {
                text: "Task duration (minutes, rounds up to nearest 5)";
            }

            duration-input := LineEdit {
                width: 75%;
                placeholder-text: "Task duration (minutes)";
                input-type: number;
            }

            Text {
                text: "Due date";
            }

            date-input := DateInput { }

            Button {
                text: "Create task";

                clicked => {
                    let submit-result = new-task(name-input.text, duration-input.text.to-float(), date-input.date);

                    if submit-result {
                        debug("UI: Form submit success");
                    } else {
                        debug("UI: Form submit FAIL");
                    }

                    new_task_popup.close()
                }
            }
        }
    }

    VerticalLayout {
        padding: 10px;
        cross-axis-alignment: CrossAxisAlignment.start;

        Text {
            text: "APM";
        }

        Button {
            text: "New Task";

            clicked => { new_task_popup.show() }
        }

        ListView { }
    }
}
